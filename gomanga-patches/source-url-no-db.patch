+        io.javalin.http.Handler { ctx ->
+            val req =
+                try {
+                    ctx.bodyAsClass(GoMangaCookieSeedRequest::class.java)
+                } catch (_: Exception) {
+                    ctx.status(400)
+                    return@Handler
+                }
+            seedHostCookies(req)
+            ctx.status(200)
+        }
