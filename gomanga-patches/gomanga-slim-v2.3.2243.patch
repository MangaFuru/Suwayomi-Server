+    private suspend fun goMangaTrueImageUrl(
+        page: SourcePage,
+        source: HttpSource,
+    ): String {
+        if (page.imageUrl == null) page.imageUrl = source.getImageUrl(page)
+        return page.imageUrl!!
+    }
